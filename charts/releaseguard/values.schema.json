{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "image", "serviceAccount", "operator", "metricGate", "resources"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of operator replicas. Values > 1 require operator.leaderElection.enabled=true."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {"name": {"type": "string", "minLength": 1}}
      }
    },
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
    "podLabels": {"type": "object", "additionalProperties": {"type": "string"}},
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["healthPort", "leaderElection", "analysis", "cleanup"],
      "properties": {
        "healthPort": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "leaderElection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "leaseName"],
          "properties": {
            "enabled": {"type": "boolean"},
            "leaseName": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "minLength": 1,
              "maxLength": 253
            }
          }
        },
        "analysis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evaluationUrl", "auth"],
          "properties": {
            "evaluationUrl": {"type": "string", "pattern": "^$|^https?://[^ ]+$"},
            "auth": {
              "type": "object",
              "additionalProperties": false,
              "required": ["existingSecret", "tokenKey"],
              "properties": {
                "existingSecret": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
                "tokenKey": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
              }
            }
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deadline", "requeueInterval"],
          "properties": {
            "deadline": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$"},
            "requeueInterval": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$"}
          }
        }
      }
    },
    "metricGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicaCount", "image", "service", "prometheusBaseUrl", "requestTimeout", "auth", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 1, "maximum": 10},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "digest", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
            "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "port": {"type": "integer", "minimum": 1024, "maximum": 65535}
          }
        },
        "prometheusBaseUrl": {"type": "string", "pattern": "^https?://[^ ]+$"},
        "requestTimeout": {"type": "string", "pattern": "^([1-9]|[1-5][0-9]|60)s$"},
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret", "tokenKey"],
          "properties": {
            "existingSecret": {"type": "string", "minLength": 1},
            "tokenKey": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
          }
        },
        "resources": {"type": "object", "additionalProperties": true}
      }
    },
    "resources": {"type": "object", "additionalProperties": true},
    "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
    "tolerations": {"type": "array", "items": {"type": "object"}},
    "affinity": {"type": "object"},
    "priorityClassName": {"type": "string"},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1, "maximum": 300},
    "revisionHistoryLimit": {"type": "integer", "minimum": 0, "maximum": 10}
  }
}
